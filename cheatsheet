## 4. Basic Code Layout Example

```assembly
.data
    # Variables go here
    val1: .word 10
    val2: .word 20

.text
.globl main
main:
    # Load address of val1 into t0
    la t0, val1        
    lw t1, 0(t0)       # t1 = 10
    
    li t2, 20          # t2 = 20 (immediate)
    
    add t3, t1, t2     # t3 = t1 + t2 = 30
    
    # Simple conditional exit check
    li t4, 30
    beq t3, t4, exit_program
    
exit_program:
    li a7, 10          # Environment call code for exit (depends on emulator)
    ecall              # System call
```

